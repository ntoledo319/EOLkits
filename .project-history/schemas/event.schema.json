{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "eolkits-history-event",
  "title": "EOLkits history event capsule front matter",
  "description": "One capsule per material decision arc (need -> intent -> alternatives -> decision -> implementation -> observed result -> consequences). Validated by scripts/project_history.py with a deliberately small schema subset: type, enum, pattern, required, properties, items, minItems, const.",
  "type": "object",
  "required": [
    "id",
    "title",
    "kind",
    "scope",
    "significance",
    "occurred_at",
    "decided_at",
    "merged_at",
    "released_at",
    "recorded_at",
    "last_verified_at",
    "claim_ids",
    "source_ids",
    "status",
    "confidence",
    "secrets_reviewed"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^eolkits-\\d{4}-\\d{2}-\\d{2}-[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Stable idempotent id: repository identity + occurred date + slug. Never renumbered."
    },
    "title": { "type": "string" },
    "kind": {
      "type": "string",
      "enum": [
        "bootstrap",
        "origin",
        "product",
        "pricing",
        "architecture",
        "interface",
        "data",
        "security",
        "deployment",
        "governance",
        "goal",
        "principle",
        "release",
        "migration",
        "incident",
        "reversal",
        "rename",
        "experiment",
        "operating-model",
        "external-constraint"
      ]
    },
    "scope": {
      "type": "string",
      "description": "project-wide, or a component name (kits, grace-api, worker, web, vscode-extension, github-action, runner, revenue, launch, ci)."
    },
    "components": { "type": "array", "items": { "type": "string" } },
    "paths": {
      "type": "array",
      "items": { "type": "string" },
      "description": "fnmatch globs used by `assess` and `context` to surface this event for touched paths."
    },
    "significance": { "type": "string", "enum": ["foundational", "high", "medium", "low"] },
    "occurred_at": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "decided_at": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "merged_at": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "released_at": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "recorded_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "last_verified_at": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "summary": { "type": "string", "description": "One sentence used by `context`." },
    "claim_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "source_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "anchors": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Full SHAs, PR numbers, release tags or other locators (rewrite-resistant where possible)."
    },
    "related": { "type": "array", "items": { "type": "string" } },
    "amends": { "type": "array", "items": { "type": "string" } },
    "supersedes": { "type": "array", "items": { "type": "string" } },
    "superseded_by": { "type": "array", "items": { "type": "string" } },
    "reversed_by": { "type": "array", "items": { "type": "string" } },
    "status": {
      "type": "string",
      "enum": ["open", "decided", "implemented", "observed", "closed", "reversed", "superseded"]
    },
    "confidence": {
      "type": "string",
      "enum": ["confirmed", "strongly_supported", "plausible", "speculative", "unknown"]
    },
    "secrets_reviewed": { "type": "boolean", "const": true },
    "revision_notes": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Append-only notes explaining what changed in this capsule, which evidence caused it, and how confidence moved."
    }
  }
}
