<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ deprecation.name }} migration guide — milestone {{ deprecation.date }} | EOLkits</title>
    <meta name="description" content="{{ meta_description }}">
    <meta name="keywords" content="{{ deprecation.name }}, AWS deprecation, {{ deprecation.service }}, {{ deprecation.tags|join(', ') }}, migration, end of life, {{ deprecation.date }}">
    <meta name="robots" content="index, follow">
    <link rel="canonical" href="{{ site_url }}/migrate/{{ deprecation.slug }}/">
    <link rel="stylesheet" href="/style.css">
    <script defer src="/track.js"></script>
    <link rel="alternate" type="text/calendar" title="AWS Deprecation Deadlines (EOLkits)" href="/deprecations.ics">

    <!-- Open Graph -->
    <meta property="og:title" content="{{ deprecation.name }} — AWS deprecation migration guide (milestone {{ deprecation.date }})">
    <meta property="og:description" content="{{ deprecation.description }}">
    <meta property="og:url" content="{{ site_url }}/migrate/{{ deprecation.slug }}/">
    <meta property="og:type" content="article">
    <meta property="og:site_name" content="EOLkits">
    <meta property="og:image" content="{{ site_url }}/og-default.png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="article:published_time" content="{{ now }}">
    <meta property="article:modified_time" content="{{ now }}">

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ deprecation.name }} — Migration Guide">
    <meta name="twitter:description" content="Tracked milestone {{ urgency.deadline_date }} ({{ urgency.days_until }} days from the build date). {{ deprecation.breaking_changes|length }} bounded migration checks to verify.">
    <meta name="twitter:image" content="{{ site_url }}/og-default.png">

    <!-- Schema.org TechArticle; the provider status source is included below. -->
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "TechArticle",
        "headline": {{ (deprecation.name ~ " — AWS Deprecation Migration Guide")|tojson }},
        "description": {{ deprecation.description|tojson }},
        "datePublished": {{ now|tojson }},
        "dateModified": {{ now|tojson }},
        "proficiencyLevel": "Expert",
        "keywords": {{ (deprecation.tags|join(", "))|tojson }},
        "citation": {{ deprecation.url|tojson }},
        "author": { "@type": "Organization", "name": "EOLkits", "url": "{{ site_url }}" },
        "publisher": {
            "@type": "Organization",
            "name": "EOLkits",
            "url": "{{ site_url }}"
        },
        "about": {
            "@type": "SoftwareApplication",
            "name": {{ deprecation.service|tojson }},
            "applicationCategory": "CloudComputing"
        },
        "mainEntityOfPage": "{{ site_url }}/migrate/{{ deprecation.slug }}/"
    }
    </script>

    <!-- Schema.org: BreadcrumbList -->
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
            { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ site_url }}/" },
            { "@type": "ListItem", "position": 2, "name": "AWS deprecations", "item": "{{ site_url }}/migrate/" },
            { "@type": "ListItem", "position": 3, "name": {{ deprecation.name|tojson }}, "item": "{{ site_url }}/migrate/{{ deprecation.slug }}/" }
        ]
    }
    </script>

    <!-- Schema.org: FAQPage (answers are deterministic, grounded in the YAML) -->
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
            {
                "@type": "Question",
                "name": "What is the next tracked milestone for {{ deprecation.name }}?",
                "acceptedAnswer": { "@type": "Answer", "text": {{ ("EOLkits tracks " ~ deprecation.date ~ " as the next published milestone. " ~ deprecation.description ~ " Provider status source: " ~ deprecation.url ~ ". Future dates can change.")|tojson }} }
            },
            {
                "@type": "Question",
                "name": "What should I verify when moving away from {{ deprecation.name }}?",
                "acceptedAnswer": { "@type": "Answer", "text": {{ ("Configured migration checks to validate in your workload: " ~ (deprecation.breaking_changes|join("; ")) ~ ". A listed check is not proof of impact. Provider status source: " ~ deprecation.url)|tojson }} }
            },
            {
                "@type": "Question",
                "name": "Which AWS services are affected by {{ deprecation.name }}?",
                "acceptedAnswer": { "@type": "Answer", "text": {{ ("Affected services: " ~ deprecation.service ~ ". Affected resource types: " ~ deprecation.resource_type ~ ". Source: " ~ deprecation.url)|tojson }} }
            },
            {
                "@type": "Question",
                "name": "Is there a free tool to migrate off {{ deprecation.name }}?",
                "acceptedAnswer": { "@type": "Answer", "text": {{ (("Yes. " ~ (deprecation.kit or "EOLkits") ~ " is an MIT-licensed CLI with bounded static checks and targeted local change previews. The optional $" ~ pricing.audit_pdf.base|string ~ " static repository evidence report adds file-and-line evidence when its fulfillment backend is ready; EOLkits does not currently sell automated pull requests.") if deprecation.kit else ("EOLkits provides cited migration guidance and, when fulfillment is ready, an optional paid static repository evidence report. It does not currently sell automated pull requests."))|tojson }} }
            }
        ]
    }
    </script>
</head>
<body class="migrate-page">

<header class="nav">
  <div class="container nav-inner">
    <a href="/" class="brand"><span class="brand-mark">▸</span> EOLkits</a>
    <nav>
      <a href="/migrate/">Deadlines</a>
      <a href="/#pricing">Pricing</a>
      <a href="/deprecations.ics">Calendar</a>
      <a href="https://github.com/ntoledo319/EOLkits" class="btn-ghost">GitHub</a>
    </nav>
  </div>
</header>

<main class="container article">
    <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a> / <a href="/migrate/">AWS deprecations</a> / <span>{{ deprecation.name }}</span>
    </nav>

    <article>
        <div class="deadline-banner {{ urgency.tier }}">
            <span class="severity-badge severity-{{ deprecation.severity }}">{{ deprecation.severity }}</span>
            <h1>{{ deprecation.name }}</h1>
            <p class="banner-sub">{{ deprecation.service }} — published migration milestone</p>
            <div class="countdown" data-deadline="{{ urgency.deadline_date }}">{{ urgency.deadline_date }}</div>
            <p class="urgency">{{ urgency.headline }}</p>
        </div>

        <section>
            <h2>What is being deprecated?</h2>
            <p>{{ deprecation.description }}</p>
            <table class="facts">
                <tr><th>Next tracked milestone</th><td><strong>{{ urgency.deadline_date }}</strong> ({{ urgency.days_until }} days from build date {{ now[:10] }})</td></tr>
                <tr><th>Service</th><td>{{ deprecation.service }}</td></tr>
                <tr><th>Affected resources</th><td><code>{{ deprecation.resource_type }}</code></td></tr>
                <tr><th>Severity</th><td><span class="severity-badge severity-{{ deprecation.severity }}">{{ deprecation.severity }}</span></td></tr>
                {% if deprecation.kit %}<tr><th>Migration kit</th><td><code>{{ deprecation.kit }}</code> (free, MIT)</td></tr>{% endif %}
                <tr><th>Primary source</th><td><a href="{{ deprecation.url }}" target="_blank" rel="noopener nofollow">{{ deprecation.url }}</a></td></tr>
            </table>
            <p class="cite-note">The published service dates and status above use the cited provider source. Recheck it before production planning because future dates can change.</p>
        </section>

        <section class="breaking-changes">
            <h2>Migration checks</h2>
            <p>When moving away from this runtime or operating-system release, verify these configured concerns in your own workload. A listed concern is not proof that every workload is affected. <a href="{{ deprecation.url }}" target="_blank" rel="noopener nofollow">[provider status source]</a></p>
            <ul>
                {% for change in deprecation.breaking_changes %}
                <li>{{ change }}</li>
                {% endfor %}
            </ul>
        </section>

        {% if deprecation.kit %}
        <section>
            <h2>Investigate with the free <code>{{ deprecation.kit }}</code> CLI</h2>
            <p>The MIT-licensed kits have different commands and coverage. Start with local help and the kit README; use fixture or dry-run modes before any command that accepts credentials or an apply flag.</p>
            <div class="migration-steps">
                <div class="step">
                    <h4>Install from this repository</h4>
                    <p>Keep dependencies isolated and inspect the available commands before running a scan.</p>
                    <pre class="code-block"><code>{% if deprecation.kit == 'lambda-lifeline' %}cd kits/lambda-lifeline
npm ci
node bin/cli.mjs --help{% else %}python3 -m venv .venv
.venv/bin/pip install -e kits/{{ deprecation.kit }}
.venv/bin/{{ deprecation.kit }} --help{% endif %}</code></pre>
                </div>
                <div class="step">
                    <h4>Review exact matches</h4>
                    <p>Treat matches as migration evidence to verify. A static scanner cannot infer live resource counts, traffic, exploitability, or business impact.</p>
                </div>
                <div class="step">
                    <h4>Preview a specific migration command</h4>
                    <p>Follow the selected kit's README. Review the diff and run the application's own tests before using an apply or deploy option.</p>
                </div>
                <div class="step">
                    <h4>Use your existing release controls</h4>
                    <p>Deploy through your tested CI, canary, monitoring, and rollback process. The scanner does not certify a production rollout.</p>
                </div>
            </div>
        </section>
        {% endif %}

        <section class="conversion">
            <h2>Need repository evidence for this migration?</h2>
            <div class="pricing-grid-2">
                <div class="pricing-card featured">
                    <h3>Audit PDF</h3>
                    <div class="price">${{ pricing.audit_pdf.base }}</div>
                    <p>Static scan of one repository ZIP or source file with exact file/line evidence, observed reach, remediation order, source links, and explicit limitations. <strong>30-day money-back guarantee.</strong></p>
                    <a href="{{ urgency.audit_link }}" class="btn-primary">Check Audit v2 availability</a>
                    <p class="small"><a href="/scan/">Run the free scan first</a> · <a href="/audit/sample/">see a sample →</a></p>
                    <p class="small">Prefer a 10-second check? Paste your config into the <a href="/eol-checker/">free AWS EOL checker</a> — nothing uploaded.</p>
                </div>
            </div>
        </section>

        <section class="embed-badge">
            <h2>Embed this milestone in your README</h2>
            <p>Drop a milestone badge into a repo that needs this migration review. It links back to the provider-sourced date and bounded checks on this page.</p>
            <p><img src="{{ site_url }}/badge/{{ deprecation.slug }}.svg" alt="{{ deprecation.name }} milestone badge"></p>
            <pre class="code-block"><code>[![{{ deprecation.name }} milestone]({{ site_url }}/badge/{{ deprecation.slug }}.svg)]({{ site_url }}/migrate/{{ deprecation.slug }}/)</code></pre>
        </section>

        {% if related %}
        <section class="related">
            <h2>Related AWS deprecations</h2>
            <p>Same service family or migration kit — each with a provider-linked milestone and checks to validate.</p>
            <ul class="related-list">
                {% for rel in related %}
                <li>
                    <a href="/migrate/{{ rel.slug }}/">{{ rel.name }}</a>
                    <span class="rel-meta">— milestone <strong>{{ rel.date }}</strong> · {{ rel.severity }}{% if rel.kit %} · <code>{{ rel.kit }}</code>{% endif %}</span>
                </li>
                {% endfor %}
            </ul>
            <p><a href="/migrate/" class="kit-link">See all tracked AWS deadlines →</a> · <a href="/deprecations.ics" class="kit-link">Subscribe to the deadline calendar (.ics) →</a></p>
        </section>
        {% endif %}

        <section class="faq" id="faq">
            <h2>Frequently asked questions</h2>
            <details open>
                <summary>What is the next tracked milestone?</summary>
                <p>{{ deprecation.date }}. {{ deprecation.description }} <a href="{{ deprecation.url }}" target="_blank" rel="noopener nofollow">[provider status source]</a></p>
            </details>
            <details>
                <summary>What should I verify before changing the workload?</summary>
                <p>Validate these configured checks against your code and current upstream documentation: {{ deprecation.breaking_changes|join("; ") }}. A listed check is not proof that the workload is affected.</p>
            </details>
            <details>
                <summary>Which AWS services does this affect?</summary>
                <p>{{ deprecation.service }} — specifically <code>{{ deprecation.resource_type }}</code> resources.</p>
            </details>
            {% if deprecation.kit %}
            <details>
                <summary>Is there a free way to migrate?</summary>
                <p>Yes — the <code>{{ deprecation.kit }}</code> CLI is MIT-licensed and free for local use. Audit v2 is an optional paid repository evidence artifact when its live safety gate is open. EOLkits does not currently sell managed migrations or automated pull requests.</p>
            </details>
            {% endif %}
        </section>
    </article>
</main>

<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <div class="brand"><span class="brand-mark">▸</span> EOLkits</div>
        <p class="muted">Tracked AWS deprecations deserve tested migration paths.</p>
      </div>
      <div>
        <h5>Deadlines</h5>
        <a href="/migrate/">Tracked AWS deprecations</a><br>
        <a href="/deprecations.ics">Deadline calendar (.ics)</a>
      </div>
      <div>
        <h5>Resources</h5>
        <a href="https://github.com/ntoledo319/EOLkits">GitHub</a><br>
        <a href="/#pricing">Pricing</a><br>
        <a href="/legal/terms.html">Terms</a> · <a href="/legal/privacy.html">Privacy</a>
      </div>
    </div>
    <div class="muted small">© 2026 EOLkits · MIT-licensed kits · provider dates carry source links</div>
  </div>
</footer>

<script>
    // Live countdown from the cited milestone date (display-only; the canonical
    // fact is the server-rendered date above).
    (function () {
        var el = document.querySelector('.countdown');
        if (!el) return;
        var deadline = new Date(el.dataset.deadline + 'T00:00:00Z');
        var diff = deadline - new Date();
        if (diff > 0) {
            var days = Math.floor(diff / 86400000);
            el.textContent = el.dataset.deadline + ' · ' + days + ' days to milestone';
        } else {
            el.textContent = el.dataset.deadline + ' · milestone passed';
        }
    })();
</script>
</body>
</html>
