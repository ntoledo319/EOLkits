{
  "name": "eolkits-vscode",
  "displayName": "EOLkits - AWS Deprecation Scanner",
  "description": "Find AWS runtime & OS end-of-life risks (Lambda Node/Python, Amazon Linux 2) in your IaC and code, right in the editor — offline, nothing uploaded.",
  "version": "1.0.0",
  "publisher": "eolkits",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#E8801A",
    "theme": "dark"
  },
  "homepage": "https://ntoledo319.github.io/EOLkits/",
  "bugs": {
    "url": "https://github.com/ntoledo319/EOLkits/issues"
  },
  "qna": "marketplace",
  "pricing": "Free",
  "sponsor": {
    "url": "https://ntoledo319.github.io/EOLkits/audit/?utm_source=vscode&utm_medium=marketplace&source=vscode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "keywords": [
    "aws",
    "lambda",
    "deprecation",
    "end-of-life",
    "eol",
    "migration",
    "amazon linux",
    "cloudformation",
    "terraform",
    "nodejs",
    "python",
    "serverless",
    "devops",
    "sre"
  ],
  "activationEvents": [
    "onLanguage:yaml",
    "onLanguage:json",
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:terraform",
    "onLanguage:python"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "eolkits.scanWorkspace",
        "title": "EOLkits: Scan Workspace for Deprecations",
        "icon": "$(search)"
      },
      {
        "command": "eolkits.showReport",
        "title": "EOLkits: Show Deprecation Report",
        "icon": "$(output)"
      },
      {
        "command": "eolkits.getAudit",
        "title": "EOLkits: Get Repository Evidence Report",
        "icon": "$(link-external)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "eolkits.scanWorkspace",
          "group": "2_workspace@5",
          "when": "explorerResourceIsFolder"
        }
      ]
    },
    "configuration": {
      "title": "EOLkits",
      "properties": {
        "eolkits.enabledKits": {
          "type": "array",
          "default": ["lambda-lifeline", "al2023-gate", "python-pivot"],
          "description": "Which EOLkits kits to enable",
          "items": {
            "type": "string",
            "enum": ["lambda-lifeline", "al2023-gate", "python-pivot"]
          }
        },
        "eolkits.severityThreshold": {
          "type": "string",
          "default": "medium",
          "description": "Minimum severity to report",
          "enum": ["low", "medium", "high", "critical"]
        },
        "eolkits.autoScan": {
          "type": "boolean",
          "default": true,
          "description": "Automatically scan on file save"
        }
      }
    },
    "views": {
      "explorer": [
        {
          "id": "eolkits.deprecations",
          "name": "AWS Deprecations"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "test": "npm run compile && npm run lint && node test/rules.test.cjs",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "1.85.0",
    "@types/node": "20.19.43",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "eslint": "10.9.0",
    "typescript": "5.9.3",
    "@vscode/vsce": "3.9.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ntoledo319/EOLkits.git",
    "directory": "apps/vscode-extension"
  },
  "license": "MIT"
}
