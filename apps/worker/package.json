{
  "name": "eolkits-worker",
  "version": "1.0.0",
  "description": "HTTP 410 tombstone for the retired EOLkits commerce worker",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "node -e \"throw new Error('Retired: deploy apps/grace-api instead')\"",
    "deploy:retired-tombstone": "wrangler deploy",
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {},
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260822.1",
    "@types/node": "^20.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5",
    "wrangler": "4.127.1"
  }
}
